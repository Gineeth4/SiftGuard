# Appwrite server configuration
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=siftguard-core

# Appwrite TablesDB table IDs
APPWRITE_SUITES_TABLE_ID=
APPWRITE_CASES_TABLE_ID=
APPWRITE_RUNS_TABLE_ID=
APPWRITE_RESULTS_TABLE_ID=
APPWRITE_DOCUMENTS_TABLE_ID=
APPWRITE_RULES_TABLE_ID=

# Vector database
QDRANT_URL=http://localhost:6333

# Local embedding service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Server-to-server and CLI authorization
SIFTGUARD_ADMIN_TOKEN=

# Browser administrator session authentication
# Required for production login
SIFTGUARD_ADMIN_PASSWORD=
SIFTGUARD_SESSION_SECRET=