import { NextResponse } from "next/server";

import {
  runDemoEvaluation,
  type DemoScenario,
} from "@/lib/phase2-demo";

const allowedScenarios = [
  "exclude_expected_document",
  "wrong_tenant_filter",
] as const;

type RegressionScenario =
  (typeof allowedScenarios)[number];

function isRegressionScenario(
  value: unknown
): value is RegressionScenario {
  return (
    typeof value === "string" &&
    allowedScenarios.some((scenario) => scenario === value)
  );
}

export const POST = async (request: Request) => {
  if (process.env.NODE_ENV === "production") {
    const expectedToken =
      process.env.SIFTGUARD_ADMIN_TOKEN;

    const suppliedToken = request.headers.get(
      "x-siftguard-admin-token"
    );

    if (
      !expectedToken ||
      !suppliedToken ||
      suppliedToken !== expectedToken
    ) {
      return NextResponse.json(
        {
          ok: false,
          error:
            "Authorised regression testing is required in production.",
        },
        { status: 401 }
      );
    }
  }

  let body: unknown;

  try {
    body = await request.json();
  } catch {
    return NextResponse.json(
      {
        ok: false,
        error: "Request body must be valid JSON.",
      },
      { status: 400 }
    );
  }

  if (
    body === null ||
    typeof body !== "object" ||
    Array.isArray(body)
  ) {
    return NextResponse.json(
      {
        ok: false,
        error: "Request body must be a JSON object.",
      },
      { status: 400 }
    );
  }

  const input = body as Record<string, unknown>;

  if (!isRegressionScenario(input.scenario)) {
    return NextResponse.json(
      {
        ok: false,
        error:
          "Unsupported scenario. Use exclude_expected_document or wrong_tenant_filter.",
      },
      { status: 400 }
    );
  }

  if (
    typeof input.baselineRunId !== "string" ||
    input.baselineRunId.trim().length === 0
  ) {
    return NextResponse.json(
      {
        ok: false,
        error:
          "baselineRunId is required. Run a successful baseline evaluation first.",
      },
      { status: 400 }
    );
  }

  try {
    const evaluation = await runDemoEvaluation({
      scenario: input.scenario as DemoScenario,
      baselineRunId: input.baselineRunId.trim(),
    });

    return NextResponse.json(
      {
        ok: true,
        message:
          "Regression scenario executed against real vector search results.",
        evaluation,
      },
      {
        status: 200,
        headers: {
          "Cache-Control": "no-store",
        },
      }
    );
  } catch (error) {
    const message =
      error instanceof Error
        ? error.message
        : "Regression evaluation failed.";

    console.error(
      "SiftGuard regression run failed:",
      message
    );

    return NextResponse.json(
      {
        ok: false,
        error: message,
      },
      {
        status: 500,
        headers: {
          "Cache-Control": "no-store",
        },
      }
    );
  }
};